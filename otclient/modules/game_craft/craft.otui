MainWindow
  size: 736 514
  image-source: images/craft/window
  &save: true
  padding: 1
  @onEscape: modules.game_gacha.hide()

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 0
    margin-right: 0
    size: 32 28
    image-source: images/fechar
    image-clip: 0 0 32 28
    @onClick: naoexibir()
    $hover:
      image-clip: 0 28 32 28
    $pressed:
      image-clip: 0 56 32 28

  UIButton
    id: previousPageButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 480
    margin-right: 100
    size: 32 28
    image-source: images/craft/back2
    image-clip: 0 0 32 28
    @onClick: previousPage()

  UIButton
    id: nextPageButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 480
    margin-right: 20
    size: 32 28
    image-source: images/craft/next2
    image-clip: 0 0 32 28
    @onClick: nextPage()

  UIButton
    id: Helmet
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 108
    margin-right: 600
    size: 50 50
    !tooltip: tr('Helmet')
    image-clip: 0 0 32 28
    @onClick: g_game.talk("!craft")

  UIButton
    id: Armor
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 206
    margin-right: 600
    size: 50 50
    !tooltip: tr('Armor')
    image-clip: 0 0 32 28
    @onClick: g_game.talk("!craft2")

  UIButton
    id: Legs
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 310
    margin-right: 600
    size: 50 50
    !tooltip: tr('Legs')
    image-clip: 0 0 32 28
    @onClick: g_game.talk("!craft3")

  UIButton
    id: Boots
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 420
    margin-right: 600
    size: 50 50
    !tooltip: tr('Boots')
    image-clip: 0 0 32 28
    @onClick: g_game.talk("!craft4")

